<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10">

    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#EDEFF3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/empty_body"
            android:textSize="14sp"
            android:textColor="#9AA3B2" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="@string/scan_button"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnManual"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/manual_button"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 连接中 / 连不上时盖在网页上。网页白屏是最没法交代的状态：
         至少要告诉用户「在连谁、为什么没连上、下一步点哪」。 -->
    <LinearLayout
        android:id="@+id/connOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0D10"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/connSpinner"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="#4D8DFF" />

        <TextView
            android:id="@+id/connTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/conn_connecting"
            android:textColor="#EDEFF3"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="#9AA3B2"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="@string/conn_retry"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSwitch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/conn_switch"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
