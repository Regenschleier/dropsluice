# 统一用 LF，避免在 Windows 上改一行就整份 diff
* text=auto eol=lf

# 脚本和配置保持 LF
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.iss   text eol=lf
*.java  text eol=lf
*.gradle text eol=lf

# Windows 批处理必须是 CRLF，否则 cmd 可能解析出错
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制：不要让 git 当文本处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.exe   binary
*.apk   binary
*.zip   binary
*.jks   binary
